{
  "evals": [
    {
      "id": "libero10-dataset-inspect",
      "prompt": "Download the LIBERO-10 training data the cosmos3-nano-robot-manipulation skill uses (nvidia/LIBERO_LeRobot_v3, folder libero_10, the revision the skill pins) and run the skill's scripts/inspect_libero10.py on it. Save the script's output as outputs/dataset_stats.txt.",
      "expected_outcome": "outputs/dataset_stats.txt reports 379 episodes, 101469 frames, 10 tasks and 20 fps for the pinned LIBERO-10 download.",
      "assertions": [
        "The dataset was downloaded with the skill's hf download command at revision e5907374380b8f96511957e6ba5582be52a1e179, folder libero_10 only",
        "scripts/inspect_libero10.py from the skill was run unchanged on the downloaded folder",
        "outputs/dataset_stats.txt contains 'episodes 379', 'frames 101469' and 'tasks 10'",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md reports the download size, the counts and the wall time"
      ],
      "checks": [
        {"path": "outputs/dataset_stats.txt", "min_bytes": 40},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["prerequisites", "dataset download", "inspect", "verify + summarize"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "budget": {"minutes": 30, "tokens": 1500000},
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
