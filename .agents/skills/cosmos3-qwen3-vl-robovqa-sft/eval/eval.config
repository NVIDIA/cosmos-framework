{
  "evals": [
    {
      "id": "smoke-rows-and-preflight",
      "prompt": "On this machine's single GPU, prepare the Qwen3-VL-8B RoboVQA SFT training rows from the skill's bundled RoboVQA clips (assets/robovqa) and run the framework's SFT preflight (--validate-manifest and --validate-rows) on them with the skill's recipe. Save the preflight output as outputs/preflight.log and the frame check summary printed by the verify step as outputs/verify.json.",
      "expected_outcome": "The bundled clips are split 4/0/2, the 4 training files pass the frame check, and the SFT preflight's train gate line in outputs/preflight.log reports rows 4 and failed 0.",
      "assertions": [
        "The SFT environment was built with the skill's uv sync command (uv 0.11.29, Python 3.13, the sft and cu130-runtime groups) and apex imports in it",
        "prepare_robovqa.py split, frames and verify ran on assets/robovqa, and outputs/verify.json reports rows 4 with all_ok true",
        "outputs/preflight.log contains a 'train: rows 4' gate line ending in 'failed 0'",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md reports the split counts, the gate line and the wall time of each step"
      ],
      "checks": [
        {"path": "outputs/preflight.log", "min_bytes": 100},
        {"path": "outputs/verify.json", "min_bytes": 40},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["prerequisites", "environments", "model download", "training rows", "preflight", "verify + summarize"]
    },
    {
      "id": "smoke-zero-shot-score",
      "prompt": "Score Qwen/Qwen3-VL-8B-Instruct (revision 0c351dd01ed87e9c1b53cbc748cba10e6187ff3b) zero-shot with the skill's RoboVQA evaluator on the held-out clips of the skill's bundled RoboVQA sample (assets/robovqa), and copy the evaluator's preds.jsonl and scores.json to outputs/.",
      "expected_outcome": "outputs/preds.jsonl holds 2 greedy answers and outputs/scores.json the exact match, token F1 and yes/no accuracy over the 2 held-out clips, produced by eval_robovqa.py in the evaluation environment.",
      "assertions": [
        "The evaluation environment was built as the skill documents (Python 3.12, torch 2.10.0+cu130, transformers 4.57.6, torchcodec 0.10.0) and the evaluator ran from it",
        "The bundled clips were split with prepare_robovqa.py and the evaluator read the resulting hf/test.jsonl and samples_test.jsonl",
        "outputs/preds.jsonl has 2 rows and outputs/scores.json reports n = 2 with no missing predictions",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md reports the scores, the wall time and the GPU memory observed"
      ],
      "checks": [
        {"path": "outputs/preds.jsonl", "min_bytes": 50},
        {"path": "outputs/scores.json", "min_bytes": 50},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["prerequisites", "evaluation environment", "model download", "split", "evaluation", "verify + summarize"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "budget": {"minutes": 75, "tokens": 3000000},
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
