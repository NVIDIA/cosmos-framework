{
  "evals": [
    {
      "id": "framework-nano-edge-transfer",
      "prompt": "Run ONE Cosmos3 video transfer with the cosmos_framework path on this machine's single GPU: Cosmos3-Nano with the skill's bundled edge control spec (specs/edge.json, which points at assets/edge/control_edge.mp4, assets/edge/prompt.json and assets/negative_prompt.json), seed 2026, guardrails disabled for this smoke. Use the public framework repository https://github.com/NVIDIA/cosmos-framework.git as the framework checkout (the checkout the environment provides, or a fresh clone) and set it up per the skill. Save the generated clip as outputs/transfer_edge_framework.mp4 and record its codec, resolution, frame count, fps and duration in result_summary.md.",
      "expected_outcome": "cosmos_framework.scripts.inference completes the edge transfer with Cosmos3-Nano on one GPU from the bundled spec and the clip (the run's transfer_edge/vision.mp4) is saved as outputs/transfer_edge_framework.mp4, with result_summary.md recording the exact command, the runtime and the clip's stream facts.",
      "assertions": [
        "Inference ran through cosmos_framework.scripts.inference with --checkpoint-path Cosmos3-Nano, --parallelism-preset=latency and the bundled specs/edge.json as -i, from the framework venv (not the system python)",
        "The framework checkout used for setup and inference is the public NVIDIA/cosmos-framework repository (the checkout the environment provides or a fresh clone shown in the transcript), set up as the skill documents",
        "outputs/transfer_edge_framework.mp4 exists and is a valid non-empty MP4 produced by that run (the run's transfer_edge/vision.mp4), about 121 frames at 30 fps and 1280x720, as the sources state for the edge control",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the video traces to a real inference run in the transcript",
        "result_summary.md contains the exact command line used, the measured runtime and the clip's stream facts actually observed"
      ],
      "checks": [
        {
          "path": "outputs/transfer_edge_framework.mp4",
          "min_bytes": 200000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "framework setup",
        "spec + inputs",
        "inference run",
        "verify + summarize"
      ]
    },
    {
      "id": "diffusers-nano-edge-transfer",
      "prompt": "Run ONE Cosmos3 video transfer with the diffusers path (Cosmos3OmniModularPipeline) on this machine's single GPU: Cosmos3-Nano with the skill's bundled edge control (specs/edge.json, which points at assets/edge/control_edge.mp4, assets/edge/prompt.json and assets/negative_prompt.json), the spec's sampling values and seed, with the safety checker disabled as the notebook does for the edge control. Save the clip as outputs/transfer_edge_diffusers.mp4 and record its codec, resolution, frame count, fps and duration in result_summary.md.",
      "expected_outcome": "A non-trivial transfer_edge_diffusers.mp4 generated by Cosmos3-Nano through Cosmos3OmniModularPipeline from the bundled edge control exists in the artifacts outputs dir, and result_summary.md records model, settings, runtime, the runner's 'cuda allocated' figure and the clip's stream facts.",
      "assertions": [
        "A dedicated Python environment was created for diffusers as the skill documents and the generation ran from it, not the system python",
        "nvidia/Cosmos3-Nano was loaded in bfloat16 through Cosmos3OmniModularPipeline and run with control_videos={'edge': ...} from the bundled control video, the spec's control_guidance, steps, guidance, fps, frame count and seed, with the safety checker disabled for edge",
        "outputs/transfer_edge_diffusers.mp4 exists and is a valid non-empty MP4 produced by the pipeline run recorded in the transcript, about 121 frames at 30 fps and 1280x720, as the sources state for the edge control",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the video traces to a real pipeline run in the transcript",
        "result_summary.md reports the settings, wall-clock time, the 'cuda allocated ... GiB' figure the notebook's runner prints after loading the pipeline, and the stream facts actually observed"
      ],
      "checks": [
        {
          "path": "outputs/transfer_edge_diffusers.mp4",
          "min_bytes": 200000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "env setup",
        "model load",
        "transfer",
        "verify + summarize"
      ]
    },
    {
      "id": "vllm-omni-nano-edge-transfer",
      "prompt": "Serve nvidia/Cosmos3-Nano with vLLM-Omni (guardrails disabled server-wide for this smoke) and run ONE edge transfer through its synchronous video API from the skill's bundled edge control (specs/edge.json, which points at assets/edge/control_edge.mp4, assets/edge/prompt.json and assets/negative_prompt.json), sending the control as a server-readable control_path the way the notebook does. Confirm the server is serving before the request, save the returned clip as outputs/transfer_edge_vllm_omni.mp4, record its codec, resolution, frame count, fps and duration in result_summary.md, then stop the server.",
      "expected_outcome": "The vLLM-Omni server comes up, serves one edge transfer request from the bundled control and prompt, and transfer_edge_vllm_omni.mp4 plus a summary with server, readiness and latency details exist in artifacts.",
      "assertions": [
        "The vLLM-Omni server was started with the documented image and command, with the skill directory mounted so the control_path it receives is readable, and was confirmed serving (the documented models endpoint) before the transfer request",
        "The request went to the documented synchronous video route as URL-encoded form fields (data=form) with the bundled edge control, prompt and negative prompt and the spec's sampling values, and the edge request disabled guardrails as the notebook does",
        "outputs/transfer_edge_vllm_omni.mp4 exists and is a valid non-empty MP4 returned by the server, about 121 frames at 30 fps and 1280x720, as the sources state for the edge control",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the video traces to a real server response in the transcript",
        "result_summary.md records the server command, time-to-ready, request latency and the stream facts actually observed, and the transcript shows the server was stopped and removed at the end"
      ],
      "checks": [
        {
          "path": "outputs/transfer_edge_vllm_omni.mp4",
          "min_bytes": 200000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "server start",
        "readiness",
        "transfer request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "sglang-nano-edge-transfer",
      "prompt": "Serve nvidia/Cosmos3-Nano with SGLang (guardrails disabled server-wide for this smoke) and run ONE edge transfer through its video API from the skill's bundled edge control (specs/edge.json, which points at assets/edge/control_edge.mp4, assets/edge/prompt.json and assets/negative_prompt.json). Confirm the server is serving before the request, poll the job until it completes, save the downloaded clip as outputs/transfer_edge_sglang.mp4, record its codec, resolution, frame count, fps and duration in result_summary.md, then stop the server.",
      "expected_outcome": "An SGLang-served Cosmos3-Nano completes one edge transfer job from the bundled control and prompt; the downloaded clip, summary and transcript are in artifacts.",
      "assertions": [
        "The SGLang server was started with the documented image and command, with the skill directory mounted at the same path so the control's host path is readable inside the container, and was confirmed serving (the documented models endpoint) before the request",
        "The request went to the documented asynchronous video route with the bundled edge control, prompt and negative prompt and the spec's sampling values; the job was polled to completion and the clip downloaded from the documented content route",
        "outputs/transfer_edge_sglang.mp4 exists and is a valid non-empty MP4 returned by the server, about 121 frames at 30 fps and 1280x720, as the sources state for the edge control",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the video traces to a real server response in the transcript",
        "result_summary.md records the server command, time-to-ready, request latency and the stream facts actually observed, and the transcript shows the server was stopped and removed at the end"
      ],
      "checks": [
        {
          "path": "outputs/transfer_edge_sglang.mp4",
          "min_bytes": 200000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "server start",
        "readiness",
        "transfer request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "trtllm-nano-edge-transfer",
      "prompt": "Serve nvidia/Cosmos3-Nano with TensorRT-LLM (trtllm-serve with the documented single-GPU Nano configuration, guardrails disabled for this smoke) and run ONE edge transfer through its synchronous video API from the skill's bundled edge control (assets/edge/control_edge.mp4 with assets/edge/prompt.json and assets/negative_prompt.json), sent the way the notebook sends it (the control base64-encoded inside extra_params). Wait for the health route before the request, save the returned MP4 as outputs/transfer_edge_trtllm.mp4, record its codec, resolution, frame count, fps and duration in result_summary.md, then stop the server.",
      "expected_outcome": "trtllm-serve hosts Cosmos3-Nano on one GPU, one edge transfer request succeeds with the bundled control and prompt, and transfer_edge_trtllm.mp4 plus summary and transcript are in artifacts.",
      "assertions": [
        "trtllm-serve was launched for nvidia/Cosmos3-Nano with the documented single-GPU configuration, with guardrails disabled via the documented mechanism rather than by acquiring gated access, and the health route answered before the request",
        "The request used the documented synchronous video route with the bundled edge control base64-encoded inside extra_params and the notebook's edge settings (121 frames, 30 fps, 1280x720, guidance 3.0, control_guidance 1.5)",
        "outputs/transfer_edge_trtllm.mp4 exists and is a valid non-empty MP4 returned by the server (video/mp4 content type, ftyp header)",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the video traces to a real server response in the transcript",
        "result_summary.md records the serve command, readiness time, request latency and the stream facts actually observed, and the transcript shows the server was stopped at the end"
      ],
      "checks": [
        {
          "path": "outputs/transfer_edge_trtllm.mp4",
          "min_bytes": 200000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "install + server start",
        "readiness",
        "transfer request",
        "teardown + summarize"
      ],
      "docker": true
    }
  ],
  "credentials": [
    "HF_TOKEN",
    "GITHUB_TOKEN"
  ],
  "gpus": 1,
  "budget": {
    "minutes": 60,
    "tokens": 3000000
  },
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "ref": "bbd4a67c3cf54cc6699464ad1259f3a0f6537da9",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
