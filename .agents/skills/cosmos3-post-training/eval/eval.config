{
  "evals": [
    {
      "id": "reasoner-peft-sft-plan-docker",
      "prompt": "Plan, but do not launch, a PEFT (LoRA) SFT run of the Cosmos3-Nano reasoner on the skill's bundled RoboVQA video-QA sample: assets/reasoner_video_qa/train/manifest.json with media in assets/reasoner_video_qa/train/media, and assets/reasoner_video_qa/validation/manifest.json with media in assets/reasoner_video_qa/validation/media. Target the local Docker platform on 1 node with 1 GPU, use nvidia/Cosmos3-Nano in the qwen3_vl checkpoint format, LoRA rank 8, alpha 16, target modules q_proj,v_proj, and 1 epoch. Use the skill's reasoner training planner from the repository that contains this skill. Save the sealed plan as outputs/sft_plan.json and the native training TOML it stages as outputs/sft.toml. This is planning only: do not download checkpoint weights, build or pull images, or start any job.",
      "expected_outcome": "outputs/sft_plan.json is the planner's sealed Docker training plan for the bundled sample (video_conversation family, 3 training and 1 validation records, an immutable Cosmos3-Nano Hub revision, LoRA rank 8 / alpha 16 on q_proj,v_proj) and outputs/sft.toml is the native Framework TOML it staged; no weights were downloaded and nothing was launched.",
      "assertions": [
        "The plan was produced by tools/cosmos_workflows/models/cosmos3-reasoner/scripts/cosmos_workflow.py plan with --platform docker, --base-model-format qwen3_vl and --training-mode peft, after resolving nvidia/Cosmos3-Nano for the train action",
        "outputs/sft_plan.json reports dataset_family video_conversation, 3 logical training records, and a model revision that is a 40-character commit hash rather than a branch name",
        "outputs/sft.toml enables LoRA with rank 8, alpha 16 and target modules q_proj,v_proj, and the plan's recorded config sha256 matches it",
        "No checkpoint weights were downloaded, no container image was built or pulled, and no docker run, job record or job submission happened",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md records the exact planner command lines and the config checksum from the plan"
      ],
      "checks": [
        {"path": "outputs/sft_plan.json", "min_bytes": 5000},
        {"path": "outputs/sft.toml", "min_bytes": 500},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["helper setup", "model resolution", "dataset inspection", "plan + spec", "verify + summarize"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "budget": {"minutes": 20, "tokens": 1000000}
}
