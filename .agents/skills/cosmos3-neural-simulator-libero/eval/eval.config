{
  "evals": [
    {
      "id": "install-recipe-and-dryrun",
      "prompt": "Following the cosmos3-neural-simulator-libero skill, set up a cosmos-framework working tree at the skill's pinned revision, install the skill's recipe files into it (the framework patch, the two experiment modules, TOMLs, launchers and scripts), and run the skill's config dry run for the forward-dynamics experiment. Save the dry run's output as outputs/dryrun.log and the list of installed files (git status --short of the working tree) as outputs/installed.txt.",
      "expected_outcome": "The patch applies cleanly at c23e51f2f157ae3e51cfcd86ebfb5464850894f2, the copied files are in place, and outputs/dryrun.log shows the action_fd_libero_posttrain experiment resolving without a traceback.",
      "assertions": [
        "A second working tree at revision c23e51f2f157ae3e51cfcd86ebfb5464850894f2 was created with git worktree, and uv sync --all-extras --group=cu130-train ran in it",
        "git apply --check and git apply of assets/neural-simulator/patches/modified_files_vs_c23e51f.diff succeeded, and the configs, TOMLs, launchers, docs, scripts and holdout_19.txt were copied to the paths the skill names",
        "outputs/dryrun.log is the output of cosmos_framework.scripts.train --sft-toml examples/toml/sft_config/action_fd_libero_posttrain.toml --dryrun and contains no traceback",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md reports the revision, the files installed and the wall time"
      ],
      "checks": [
        {"path": "outputs/dryrun.log", "min_bytes": 100},
        {"path": "outputs/installed.txt", "min_bytes": 100},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["prerequisites", "working tree and environment", "install recipe files", "dry run", "verify + summarize"]
    },
    {
      "id": "holdout-and-leakage-check",
      "prompt": "Following the cosmos3-neural-simulator-libero skill, download the pinned LIBERO-10 dataset into a cosmos-framework working tree at the skill's pinned revision with the skill's recipe files installed, regenerate the 19-episode held-out list with the skill's make_holdout.py, confirm it equals the skill's pinned assets/neural-simulator/holdout_19.txt, and run the skill's leakage_check.py. Save the generated list as outputs/holdout_19.generated.txt and the leakage report as outputs/leakage_check.json.",
      "expected_outcome": "outputs/holdout_19.generated.txt lists the same 19 episode ids as the pinned file (2 per task, 1 for task 8), and outputs/leakage_check.json reports 0 overlapping episode ids and 0 duplicate action sequences between the training and held-out splits.",
      "assertions": [
        "The dataset was downloaded with the skill's hf download command at revision e5907374380b8f96511957e6ba5582be52a1e179, folder libero_10 only",
        "make_holdout.py and leakage_check.py from the skill ran unchanged from the working tree with PYTHONPATH=. as the skill documents",
        "The generated held-out ids equal those in assets/neural-simulator/holdout_19.txt, and outputs/leakage_check.json shows 0 overlapping ids and 0 duplicate action sequences",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md reports the counts, the nearest-neighbour RMSE figures and the wall time"
      ],
      "checks": [
        {"path": "outputs/holdout_19.generated.txt", "min_bytes": 200},
        {"path": "outputs/leakage_check.json", "min_bytes": 50},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["prerequisites", "working tree and environment", "install recipe files", "dataset download", "holdout + leakage check", "verify + summarize"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "budget": {"minutes": 60, "tokens": 2500000},
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
