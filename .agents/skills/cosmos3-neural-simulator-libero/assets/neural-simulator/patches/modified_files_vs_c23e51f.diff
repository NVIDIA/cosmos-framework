+# Preload the CUDA-13 NPP / NVRTC shared libraries that ship in the ``nvidia-npp`` /
+# ``nvidia-cuda-nvrtc`` wheels (installed under site-packages/nvidia/cu13/lib on this
+# layout). torchcodec's libtorchcodec_core*.so links libnppicc.so.13 / libnvrtc.so.13 but
+# has no RPATH into that directory and torch does not preload NPP, so without this
+# ``import torchcodec`` fails with "libnppicc.so.13: cannot open shared object file"
+# and every LeRobot video decode (default backend torchcodec) errors out. Opt out with
+# COSMOS_PRELOAD_CU13_LIBS=0. Only files that exist are loaded; failures are ignored.
+if os.environ.get("COSMOS_PRELOAD_CU13_LIBS", "1") != "0":
