          "min_bytes": 400
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "framework setup",
        "teacher snapshot + scene download",
        "bundle build + initializer conversion",
        "stage selection + short-run settings + dry run",
