  "failure_event_policy": {
    "convention": "active_failure_event_only_v1",
    "intervals": "[start, end)",
    "failure_labels": [
      "pickup_miss",
      "pickup_slip",
      "handover_drop"
    ],
    "post_event_label": "normal",
    "instructions": "Label only the active failure event. After the fall or empty withdrawal finishes, return to Normal. Keep the episode failure outcome; label recovery separately on the task-phase track.",
    "unknown_evidence_label": "unknown",
    "end_rule": "End at the first frame after the visible event finishes. If still active at clip end, record event_end_observed=false."
  }
}
