{
  "evals": [
    {
      "id": "nim-generator-nano-t2i",
      "prompt": "Deploy the Cosmos3 NIM as a Nano Generator on this machine's single GPU and generate ONE image with the NIM cookbook's text-to-image client (.agents/skills/cookbooks/cosmos3/nim/examples/t2i.py); save the JPEG it returns as outputs/t2i_nim.jpg, then stop the container. Never fabricate output.",
      "expected_outcome": "outputs/t2i_nim.jpg is the JPEG the cookbook's t2i.py received from a ready Nano Generator NIM (960 x 960 at the T2I default resolution 720_1_1), and result_summary.md records the image tag, the selected profile, time-to-ready and the request latency.",
      "assertions": [
        "The NIM container was launched from the pinned image nvcr.io/nim/nvidia/cosmos3:2.1.0 with NIM_MODEL_TYPE=generator, NIM_MODEL_VARIANT=nano and NIM_PERF_PROFILE=latency after the cookbook's pre-download profile preflight, and /v1/health/ready plus /v1/metadata (model_type generator, inference_endpoint /v1/infer) were confirmed before the first request",
        "The image was produced by the cookbook's examples/t2i.py run from the pinned uv client environment (uv sync --locked in .agents/skills/cookbooks/cosmos3/nim), not by a hand-written request or a different client",
        "outputs/t2i_nim.jpg exists and is a valid non-empty JPEG decoded from the b64_image field of a real /v1/infer response recorded in the transcript (not copied from elsewhere or fabricated)",
        "The skill's documented workflow executed without errors on the first attempt",
        "The container was stopped at the end with its logs saved, and result_summary.md records the image tag, the selected profile (from /v1/metadata or examples/inspect_profile.py), time-to-ready and the request latency actually observed"
      ],
      "checks": [
        {
          "path": "outputs/t2i_nim.jpg",
          "min_bytes": 10000
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "client env + NGC login",
        "preflight + launch",
        "readiness + metadata",
        "t2i request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "nim-reasoner-nano-image-caption",
      "prompt": "Deploy the Cosmos3 NIM as a Nano Reasoner on this machine's single GPU and caption one image with the NIM cookbook's catalog client (.agents/skills/cookbooks/cosmos3/nim/examples/reasoner.py --case image_caption; its input is .agents/skills/cookbooks/cosmos3/reasoner/assets/robot_153.jpg); save the answer it writes as outputs/reasoner_image_caption.txt and its report.md as outputs/reasoner_image_caption_report.md, then stop the container. Never fabricate an answer.",
      "expected_outcome": "outputs/reasoner_image_caption.txt holds the caption a ready Nano Reasoner NIM returned for robot_153.jpg through the cookbook's reasoner.py (Chat Completions), outputs/reasoner_image_caption_report.md is the client's report for the case, and result_summary.md records the image tag, the selected profile, time-to-ready and the request latency.",
      "assertions": [
        "The NIM container was launched from the pinned image nvcr.io/nim/nvidia/cosmos3:2.1.0 with NIM_MODEL_TYPE=reasoner and NIM_MODEL_VARIANT=nano and without NIM_PERF_PROFILE after the cookbook's Reasoner profile preflight, and /v1/health/ready plus /v1/metadata (model_type reasoner, inference_endpoint /v1/chat/completions) were confirmed before the first request",
        "robot_153.jpg was materialised from git-LFS into a real JPEG (not the ~130-byte pointer file) before the request, and the request was sent by the cookbook's examples/reasoner.py --case image_caption from the pinned uv client environment with the catalog's prompt and sampling values unchanged",
        "outputs/reasoner_image_caption.txt is the non-empty caption from message.content of a real chat completion recorded in the transcript (not fabricated), and outputs/reasoner_image_caption_report.md is the client's report for the case",
        "The skill's documented workflow executed without errors on the first attempt",
        "The container was stopped at the end with its logs saved, and result_summary.md records the image tag, the selected profile, time-to-ready and the request latency actually observed without presenting the Nano result as Super-validated"
      ],
      "checks": [
        {
          "path": "outputs/reasoner_image_caption.txt",
          "min_bytes": 50
        },
        {
          "path": "outputs/reasoner_image_caption_report.md",
          "contains": "## Final answer"
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "client env + asset materialisation",
        "preflight + launch",
        "readiness + metadata",
        "image_caption request",
        "teardown + summarize"
      ],
      "docker": true
    }
  ],
  "credentials": [
    "NGC_API_KEY"
  ],
  "gpus": 1,
  "budget": {
    "minutes": 60,
    "tokens": 3000000
  },
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
