{
  "evals": [
    {
      "id": "framework-nano-image-caption",
      "prompt": "Describe the skill's bundled robot image (assets/robot_153.jpg) with the Cosmos3 Reasoner through the Cosmos Framework inference entrypoint on this machine's single GPU. Use a fresh clone of the public framework repository, https://github.com/NVIDIA/cosmos-framework.git (branch main), as the framework checkout (COSMOS3_REPO) and set it up as the skill documents; run Cosmos3-Nano in reasoner mode on the notebook's nano_image input (prompt \"Describe what is happening in this image in one sentence.\", enable_sound false, seed 0) and save the text the run wrote (its reasoner_text.txt) as outputs/caption_framework_nano.txt.",
      "expected_outcome": "The framework inference completes on one GPU with Cosmos3-Nano and outputs/caption_framework_nano.txt holds the one-sentence description the run wrote to reasoner_text.txt; result_summary.md records the exact command, runtime and GPU memory.",
      "assertions": [
        "Inference ran through cosmos_framework.scripts.inference with --checkpoint-path Cosmos3-Nano on a reasoner-mode input JSON that sets enable_sound to false and points vision_path at the skill's assets/robot_153.jpg",
        "The framework checkout used for setup and inference is a clone of the public NVIDIA/cosmos-framework main set up per the skill (uv sync with the documented dependency group), not the skill snapshot",
        "outputs/caption_framework_nano.txt exists, is non-empty, and is the reasoner_text.txt the run wrote (not typed or edited by the agent)",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the saved text traces to a real inference run in the transcript",
        "result_summary.md contains the exact command line used, the measured runtime and the GPU memory observed"
      ],
      "checks": [
        {
          "path": "outputs/caption_framework_nano.txt",
          "min_bytes": 40
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "framework setup",
        "input file",
        "inference run",
        "verify + summarize"
      ]
    },
    {
      "id": "vllm-edge-image-caption",
      "prompt": "Serve nvidia/Cosmos3-Edge with the vLLM Docker image as the skill documents (one GPU), wait until the server reports healthy, then ask it to caption the skill's bundled robot image (assets/robot_153.jpg) with the prompt \"Caption the image in detail.\" through the OpenAI-compatible chat API; save the model's reply as outputs/caption_vllm_edge.txt, then stop and remove the server container.",
      "expected_outcome": "The vLLM server comes up for Cosmos3-Edge, one image-caption request from the bundled image succeeds, and outputs/caption_vllm_edge.txt holds the returned caption; result_summary.md records the launch command, time-to-ready and request latency.",
      "assertions": [
        "The vLLM server was started with the documented image and launch flags for Cosmos3-Edge and reached /health readiness before any request was sent",
        "The request carried the skill's bundled assets/robot_153.jpg as the image input with the prompt 'Caption the image in detail.'",
        "outputs/caption_vllm_edge.txt exists, is non-empty and is the server's response text",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the saved caption traces to a real server response in the transcript, not to text typed or edited by the agent",
        "The server container was stopped and removed at the end, and result_summary.md records the launch command, time-to-ready and request latency actually observed"
      ],
      "checks": [
        {
          "path": "outputs/caption_vllm_edge.txt",
          "min_bytes": 100
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "server start",
        "readiness",
        "caption request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "sglang-edge-image-caption",
      "prompt": "Serve nvidia/Cosmos3-Edge with the SGLang Docker image as the skill documents (one GPU), wait until the server reports healthy, then ask it to caption the skill's bundled robot image (assets/robot_153.jpg) with the prompt \"Caption the image in detail.\" through the OpenAI-compatible chat API; save the model's reply as outputs/caption_sglang_edge.txt, then stop and remove the server container.",
      "expected_outcome": "The SGLang server comes up for Cosmos3-Edge, one image-caption request from the bundled image succeeds, and outputs/caption_sglang_edge.txt holds the returned caption; result_summary.md records the launch command, time-to-ready and request latency.",
      "assertions": [
        "The SGLang server was started with the documented image and launch flags for Cosmos3-Edge and reached /health readiness before any request was sent",
        "The request carried the skill's bundled assets/robot_153.jpg as the image input with the prompt 'Caption the image in detail.'",
        "outputs/caption_sglang_edge.txt exists, is non-empty and is the server's response text",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the saved caption traces to a real server response in the transcript, not to text typed or edited by the agent",
        "The server container was stopped and removed at the end, and result_summary.md records the launch command, time-to-ready and request latency actually observed"
      ],
      "checks": [
        {
          "path": "outputs/caption_sglang_edge.txt",
          "min_bytes": 100
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "server start",
        "readiness",
        "caption request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "tensorrt-llm-nano-image-caption",
      "prompt": "Serve nvidia/Cosmos3-Nano with the TensorRT-LLM release container as the skill documents (one GPU), wait until the server reports healthy, then ask it to caption the skill's bundled robot image (assets/robot_153.jpg) with the prompt \"Caption the image in detail.\" through the OpenAI-compatible chat API; save the model's reply as outputs/caption_trtllm_nano.txt, then stop and remove the server container.",
      "expected_outcome": "trtllm-serve hosts Cosmos3-Nano in the documented release container, one image-caption request from the bundled image succeeds, and outputs/caption_trtllm_nano.txt holds the returned caption; result_summary.md records the launch command, time-to-ready and request latency.",
      "assertions": [
        "The TensorRT-LLM server was started with the documented release image and launch command for Cosmos3-Nano and reached /health readiness before any request was sent",
        "The request carried the skill's bundled assets/robot_153.jpg as the image input with the prompt 'Caption the image in detail.'",
        "outputs/caption_trtllm_nano.txt exists, is non-empty and is the server's response text",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the saved caption traces to a real server response in the transcript, not to text typed or edited by the agent",
        "The server container was stopped and removed at the end, and result_summary.md records the launch command, time-to-ready and request latency actually observed"
      ],
      "checks": [
        {
          "path": "outputs/caption_trtllm_nano.txt",
          "min_bytes": 100
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "image pull + server start",
        "readiness",
        "caption request",
        "teardown + summarize"
      ],
      "docker": true
    },
    {
      "id": "transformers-nano-image-caption",
      "prompt": "Caption the skill's bundled robot image (assets/robot_153.jpg) in process with Hugging Face Transformers as the skill documents: create the documented venv, load the nvidia/Cosmos3-Nano Reasoner on this machine's single GPU and run the image request with the prompt \"Caption the image in detail.\"; save the generated text as outputs/caption_transformers_nano.txt.",
      "expected_outcome": "The Transformers venv loads nvidia/Cosmos3-Nano's Reasoner tower on one GPU and generates a caption for the bundled image; outputs/caption_transformers_nano.txt holds the generated text and result_summary.md records versions, load time, generation time and GPU memory.",
      "assertions": [
        "A dedicated venv was created with the skill's documented install block and the model ran from it, not from the system python",
        "nvidia/Cosmos3-Nano was loaded with Cosmos3OmniForConditionalGeneration in bfloat16 on the GPU and the request used the skill's bundled assets/robot_153.jpg",
        "outputs/caption_transformers_nano.txt exists, is non-empty and is the text model.generate produced, not fabricated or edited",
        "The skill's documented workflow executed without errors on the first attempt",
        "No output was fabricated: the saved text traces to a real generation in the transcript",
        "result_summary.md records the transformers and torch versions, model load time, generation time and GPU memory actually observed"
      ],
      "checks": [
        {
          "path": "outputs/caption_transformers_nano.txt",
          "min_bytes": 100
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "venv install",
        "model load",
        "image request",
        "verify + summarize"
      ]
    },
    {
      "id": "trt-edge-llm-edge-onnx-export",
      "prompt": "Prepare the Cosmos3-Edge Reasoner for TensorRT-Edge-LLM on this x86 host as far as the skill documents it runs on a host without the device runtime: run the CPU ONNX export of nvidia/Cosmos3-Edge with --task reasoning into a workspace, write the image-reasoning request input.json for the skill's bundled assets/robot_153.jpg and copy it to outputs/input.json, and write a listing of the export directory (file names and sizes; write it even if the export left the directory empty or missing, saying so) to outputs/onnx_listing.txt. The engine build and llm_inference steps need the compiled C++ runtime with TensorRT, which this host does not provide: do not fabricate an output.json. If the export itself fails after a genuine attempt, record the exact error and the step reached in result_summary.md.",
      "expected_outcome": "The ONNX export of nvidia/Cosmos3-Edge (task reasoning) exists on disk and outputs/onnx_listing.txt lists it; outputs/input.json is the notebook's request for assets/robot_153.jpg; result_summary.md states which steps ran and that the engine build and inference were not attempted for lack of the C++ runtime (or documents the measured export blocker).",
      "assertions": [
        "The TensorRT-Edge-LLM Python package was installed from the documented v0.11.0 source per the upstream installation guide and tensorrt-edgellm-export ran on CPU with --task reasoning for nvidia/Cosmos3-Edge, or the exact failure of a genuine attempt is documented with the error text",
        "outputs/input.json matches the notebook's request shape: batch_size 1, max_generate_length 256, one user message with an image block pointing at the skill's assets/robot_153.jpg and the text 'Caption the image in detail.'",
        "outputs/onnx_listing.txt lists the exported files actually present in the ONNX directory (names and sizes read from the filesystem)",
        "No output was fabricated: no output.json or inference result was invented, and the engine build and llm_inference were reported as not run on this host",
        "The skill's documented host-side workflow (export and request file) executed without errors on the first attempt",
        "result_summary.md records the steps reached, their durations and any blocker with the exact error text"
      ],
      "checks": [
        {
          "path": "outputs/input.json",
          "contains": "robot_153.jpg"
        },
        {
          "path": "outputs/onnx_listing.txt",
          "min_bytes": 20
        },
        {
          "path": "result_summary.md",
          "min_bytes": 150
        },
        {
          "path": "transcript.md",
          "min_bytes": 300
        }
      ],
      "stages": [
        "install TensorRT-Edge-LLM",
        "CPU ONNX export",
        "request input.json",
        "summarize (engine build and inference not available on this host)"
      ]
    }
  ],
  "credentials": [
    "HF_TOKEN",
    "GITHUB_TOKEN"
  ],
  "gpus": 1,
  "budget": {
    "minutes": 60,
    "tokens": 3000000
  },
  "setup": {
    "repo": "https://github.com/NVIDIA/cosmos-framework.git",
    "dest": "/app/repo",
    "src_mount": "/opt/cosmos-src"
  }
}
