{
  "evals": [
    {
      "id": "reasoner-cli-edge-video",
      "prompt": "Ask nvidia/Cosmos3-Edge \"What action is possible right now?\" about the skill's bundled robot clip (assets/reasoner/robot_sachet.mp4) through the Framework's native reasoner inference command, cosmos-reasoner-inference, on this machine's single GPU with 8 frames and at most 128 new tokens. The framework checkout is the repository that contains this skill; install it with its optional workflows dependencies as the skill documents. Write the results under outputs/reasoner_cli, so the answer lands in outputs/reasoner_cli/inference_results/robot_sachet_result.txt.",
      "expected_outcome": "cosmos-reasoner-inference runs Cosmos3-Edge on one GPU over the bundled clip and writes robot_sachet_result.txt and inference_summary.json under outputs/reasoner_cli/inference_results, with a SUCCESS line in outputs/reasoner_cli/status.json.",
      "assertions": [
        "The framework was installed from the repository that contains this skill, with the workflows extra, and cosmos-reasoner-inference (or python -m cosmos_framework.scripts.inference_reasoner) ran from that environment",
        "The command used --model_path for a complete nvidia/Cosmos3-Edge Hugging Face snapshot, --media assets/reasoner/robot_sachet.mp4, --type video, --num_frames 8, --max_new_tokens 128 and --results_dir outputs/reasoner_cli",
        "outputs/reasoner_cli/inference_results/robot_sachet_result.txt is non-empty model output written by the run, not text typed or edited by the agent",
        "outputs/reasoner_cli/status.json ends with a SUCCESS status line",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md records the exact command, the measured runtime and the GPU memory observed"
      ],
      "checks": [
        {"path": "outputs/reasoner_cli/inference_results/robot_sachet_result.txt", "min_bytes": 10},
        {"path": "outputs/reasoner_cli/inference_results/inference_summary.json", "min_bytes": 50},
        {"path": "outputs/reasoner_cli/status.json", "min_bytes": 50},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["framework setup", "checkpoint download", "inference run", "verify + summarize"]
    },
    {
      "id": "reasoner-http-service-edge",
      "prompt": "Serve nvidia/Cosmos3-Edge with the Framework's reasoner HTTP service (cosmos-reasoner-serve) on 127.0.0.1 on this machine's single GPU, allowing only the skill's assets/reasoner directory as a media root and the public model name cosmos. The framework checkout is the repository that contains this skill; install it with its optional workflows dependencies as the skill documents. Wait until /health reports ready, save the /v1/models response as outputs/models.json, then send one /v1/chat/completions request with the bundled clip assets/reasoner/robot_sachet.mp4 as a video_url part and the text \"What action is possible right now?\", save the raw JSON response as outputs/chat_response.json, and stop the server.",
      "expected_outcome": "cosmos-reasoner-serve comes up on loopback for Cosmos3-Edge, /v1/models lists cosmos, one chat completion over the bundled clip returns a non-empty answer saved in outputs/chat_response.json, and the server is stopped afterwards.",
      "assertions": [
        "The server was started with cosmos-reasoner-serve bound to 127.0.0.1, --model-name cosmos and --media-root pointing at the skill's assets/reasoner directory, without --allow-remote-media",
        "/health reported ready before the first /v1/models or /v1/chat/completions request was sent",
        "outputs/chat_response.json is the server's raw response and its first choice carries a non-empty message content",
        "The server process was stopped at the end and nothing is still listening on its port",
        "The skill's documented workflow executed without errors on the first attempt",
        "result_summary.md records the launch command, the time to ready and the request latency actually observed"
      ],
      "checks": [
        {"path": "outputs/models.json", "min_bytes": 20},
        {"path": "outputs/chat_response.json", "min_bytes": 100},
        {"path": "result_summary.md", "min_bytes": 150},
        {"path": "transcript.md", "min_bytes": 300}
      ],
      "stages": ["framework setup", "checkpoint download", "server start", "readiness", "chat request", "teardown + summarize"]
    }
  ],
  "credentials": ["HF_TOKEN"],
  "gpus": 1,
  "budget": {"minutes": 60, "tokens": 3000000}
}
