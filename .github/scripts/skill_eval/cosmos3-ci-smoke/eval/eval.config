{
  "evals": [
    {
      "id": "smoke-hello",
      "prompt": "Create outputs/hello.txt containing exactly the line `cosmos skill eval smoke OK`, then print the file back.",
      "expected_outcome": "outputs/hello.txt exists with that exact line, and result_summary.md records the step taken.",
      "assertions": [
        "outputs/hello.txt contains exactly the line 'cosmos skill eval smoke OK'",
        "result_summary.md describes what was done"
      ],
      "checks": [
        {"path": "outputs/hello.txt", "min_bytes": 20},
        {"path": "result_summary.md", "min_bytes": 40},
        {"path": "transcript.md", "min_bytes": 50}
      ],
      "stages": ["write", "verify"]
    },
    {
      "id": "smoke-python",
      "prompt": "Using python3, compute the sum of the integers 1 through 100 and write it to outputs/sum.json as {\"sum\": <value>}; then print the file back.",
      "expected_outcome": "outputs/sum.json contains {\"sum\": 5050} and result_summary.md records the command used.",
      "assertions": [
        "outputs/sum.json parses as JSON with sum equal to 5050",
        "python3 was used to compute the value",
        "result_summary.md records the command that was run"
      ],
      "checks": [
        {"path": "outputs/sum.json", "min_bytes": 8},
        {"path": "result_summary.md", "min_bytes": 40},
        {"path": "transcript.md", "min_bytes": 50}
      ],
      "stages": ["compute", "verify"]
    }
  ],
  "credentials": [],
  "gpus": 1,
  "budget": {"minutes": 5, "tokens": 200000}
}
